// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/debian
{
    "name": "Rust",
    // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
    // "image": "mcr.microsoft.com/devcontainers/rust:latest",
    // "image": "rust:latest",
    "build": {
        "dockerfile": "Dockerfile"
    },
    // Configure tool-specific properties.
    "customizations": {
        // Configure properties specific to VS Code.
        "vscode": {
            // Add the IDs of extensions you want installed when the container is created.
            "extensions": [
                "ms-azuretools.vscode-docker",
                "rust-lang.rust-analyzer",
                "tamasfe.even-better-toml"
            ],
            "settings": {
                "remote.portsAttributes": {
                    // Forward standard ports if they show up
                    "8000-9000": {
                        "onAutoForward": "notify"
                    },
                    // Ignore auto forwarding for other high ports
                    "10000-65535": {
                        "onAutoForward": "ignore"
                    }
                },
                "rust-analyzer.check.command": "clippy",
                "rust-analyzer.cargo.buildScripts.enable": true,
                "rust-analyzer.procMacro.enable": true
            }
        }
    },
    // Features to add to the dev container. More info: https://containers.dev/features.
    "features": {
        "ghcr.io/devcontainers/features/github-cli:1": {},
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
            "version": "latest",
            "enableNonRootDocker": "true",
            "moby": false
        },
        "ghcr.io/devcontainers/features/node:1": {},
        "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
    },
    // Use 'mounts' to make the cargo cache persistent in a Docker Volume.
    "mounts": [
        "source=devcontainer-cargo-cache-${devcontainerId},target=/usr/local/cargo,type=volume",
        "source=claude-code-config,target=/home/vscode/.claude,type=volume",
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude/CLAUDE.md,target=/home/vscode/.claude/CLAUDE.md,type=bind,consistency=cached",
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude/.credentials.json,target=/home/vscode/.claude/.credentials.json,type=bind,consistency=cached"
    ],
    "postAttachCommand": "sudo chown vscode:vscode /home/vscode/.claude && sudo chown -R vscode:rustlang /usr/local/cargo",
    // Use 'postCreateCommand' to run commands after the container is created.
    "postCreateCommand": "rustc --version",
    // Use 'postStartCommand' to run commands every time the container is started.
    "postStartCommand": "rustc --version && git config --global --add safe.directory ${containerWorkspaceFolder} && git config --global gpg.program \"gpg\" && git config --global commit.gpgsign true"
}